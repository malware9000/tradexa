# Neon (serverless PostgreSQL) connection string.
# Copy this file to `.env` and fill in your Neon values.
#
# Neon gives you two connection strings:
#   - Unpooled (direct): ...@<host>.neon.tech/...  (use for migrations/Prisma CLI)
#   - Pooled (PgBouncer): ...@<host>-pooler.neon.tech/... (use for the runtime API)
#
# Prisma Migrate / db push: use the unpooled/direct URL.
# The running API/worker: use the pooled URL with sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/tradexa?sslmode=require"
