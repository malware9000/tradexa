PORT=3000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Neon (serverless PostgreSQL). Use the PgBouncer *pooled* URL with sslmode=require
# for the running API. Prisma CLI migrations should use the direct/unpooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/tradexa?sslmode=require"

JWT_SECRET=change-me-in-development
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
